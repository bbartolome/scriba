{
  "name": "scriba",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web",
    "packages/packs"
  ],
  "scripts": {
    "dev": "echo \"scriba dev: no runnable app yet; the real dev script lands in phase:scaffold s4\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
